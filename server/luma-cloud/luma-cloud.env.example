# Copy to /etc/luma-cloud.env (sudo chmod 600 /etc/luma-cloud.env) and fill in your own values.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=luma
DB_PASSWORD=change-me
DB_NAME=luma
HOST=127.0.0.1
PORT=8788
# Admin page https://<your domain>/admin: your own password, at least 12 characters (empty = admin page off).
ADMIN_PASSWORD=
# Sign in with Apple: the app's bundle id (comma-separated if more than one).
APPLE_BUNDLE_IDS=com.scyde.luma
# Google Sign-In: OAuth client ids of the iOS app and of the Android app's "web" (server) client.
GOOGLE_CLIENT_IDS=
# Facebook Login: app id and app secret from developers.facebook.com (App settings -> Basic).
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
